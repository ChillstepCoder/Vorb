emitters:
  - Emitter:
      scale: [0.1,0.1]
      color: [255,255,255,255]
      max_particles: 2000
      lifetime: 5
      looping: 1
      blend: additive
      e_update:
        - spawn_rate:
            emit_rate: 0
            initial_delay: 0
            spawn_count: 3
      p_init:
        - cone_burst:
            speed_range: [1,1]
            angle_range: [0,0.7853982]
            dir: [0,0,1]
        - set_color:
            color: [255,0,0,175]
      p_update:
        - drag_force:
            drag: 0.75
        - set_scale:
            scale:
              f32_to_vec2:
                p0:
                  add_f32:
                    p0: 1
                    p1:
                      negate_f32:
                        p0:
                          p_norm_life: {}
