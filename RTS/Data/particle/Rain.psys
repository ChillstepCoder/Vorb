emitters:
  - DefaultEmitter:
      scale: [0.1,0.1]
      color: [255,255,255,255]
      max_particles: 2000
      lifetime: 10
      p_lifespan: 3
      looping: 1
      blend: additive
      e_update:
        - spawn_rate:
            emit_rate: 0.01
            initial_delay: 0
            spawn_count: 10
      p_init:
        - set_velocity:
            vel: [2,0,-6]
        - set_position:
            pos:
              add_vec3:
                p0: [-3,0,10]
                p1:
                  rnd_point_shape:
                    type: box
                    half_extents: [3,3,1]
        - set_scale:
            scale: [1,5]
        - set_hdr_color:
            color: [0.5,0.6,0.7,0.1]
        - mult_scale:
            scale:
              f32_to_vec2:
                v:
                  rand_float:
                    min: 0.1
                    max: 1
                    seed_by_p: 1
      p_update:
        - orient_vel: {}
        - turbulence:
            scale_fac: [1,1,1]
            dir_off: [0,0,0]
