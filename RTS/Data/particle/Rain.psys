emitters:
  - DefaultEmitter:
      scale: [0.1,0.1]
      color: [255,255,255,255]
      max_particles: 2000
      lifetime: 5
      looping: 1
      blend: additive
      e_update:
        - spawn_rate:
            emit_rate: 0
            initial_delay: 0
            spawn_count: 3
      p_init:
        - set_velocity:
            vel: [3,0,-3]
        - set_position:
            pos:
              add_vec3:
                p0: [0,0,2.4]
                p1:
                  rnd_point_shape:
                    type: box
                    half_extents: [3,3,1]
        - set_scale:
            scale: [1,5]
        - set_hdr_color:
            color: [0,1,1,0.2]
      p_update:
        - orient_vel: {}
        - drag_force:
            drag: 0.75
        - turbulence:
            scale_fac: [1,1,1]
            dir_off: [0,0,0]
