emitters:
  - defaultemitter:
      scale: [0.02,0.02]
      color: [255,255,255,255]
      max_particles: 2000
      lifetime: 1.63
      p_lifespan: 1.01
      looping: 1
      blend: alpha
      mat: tree_particle_02
      shader: particle_bb_3d
      e_update:
        - spawn_burst:
            delay: 0
            spawn_count: 60
      p_init:
        - ring_burst:
            speed_range: [1,2]
            max_angle: 20
            ring_normal:
              i_inorm: {}
        - mult_vel:
            scale: [1.5,1,1]
        - set_rotation:
            rot:
              make_vec2:
                x:
                  rand_float:
                    min: 0
                    max: 6
                    seed_by_p: 0
                y:
                  rand_float:
                    min: 0
                    max: 6
                    seed_by_p: 0
      p_update:
        - apply_force:
            force: [0,0,-2]
        - drag_force:
            drag: 0.3
        - set_scale:
            scale:
              f32_to_vec2:
                v:
                  sub_f32:
                    p0: 1
                    p1:
                      float_curve:
                        norm_input:
                          p_norm_life: {}
                        keys:
                          - [0,0]
                          - [1,1]
        - turbulence:
            scale_fac: [2,2,2]
            dir_off: [0,0,0]
        - mult_scale:
            scale:
              f32_to_vec2:
                v:
                  rand_float:
                    min: 1
                    max: 3
                    seed_by_p: 1
  - cone:
      scale: [0.02,0.02]
      color: [255,255,255,255]
      max_particles: 2000
      lifetime: 3
      p_lifespan: 3
      looping: 1
      blend: alpha
      mat: tree_particle_02
      shader: particle_bb_3d
      e_update:
        - spawn_burst:
            delay: 0
            spawn_count: 100
      p_init:
        - cone_burst:
            speed_range: [2,4]
            angle_range: [0,0.7853982]
            dir:
              i_idir: {}
        - set_color:
            color: [255,255,255,255]
        - set_rotation:
            rot:
              make_vec2:
                x:
                  rand_float:
                    min: 0
                    max: 6
                    seed_by_p: 0
                y:
                  rand_float:
                    min: 0
                    max: 6
                    seed_by_p: 0
      p_update:
        - drag_force:
            drag: 0.75
        - apply_force:
            force: [0,0,-4]
        - set_scale:
            scale:
              f32_to_vec2:
                v:
                  float_curve:
                    norm_input:
                      p_norm_life: {}
                    keys:
                      - [0,1]
                      - [1,0]
