lumbermill:
  width_range: [30, 40]
  public_room_count_range: [1, 1]
  private_room_count_range: [1, 2]
  min_aspect_ratio: 1.0
  public_room_grammars:
    - bb
    - b|0
  public_rooms:
    - name: workshop
      count_range: [1, 1]
  private_rooms:
    - name: large_stockpile
      count_range: [1, 2]
  function: lumbermill
  employs: [1, 5]