layout(triangles, equal_spacing, ccw) in;

#include "../GlobalUbo.glsl"

#include "../util/wind.glsl"

const float WIND_INTENSITY = 0.75;

// uniform float gDispFactor;

in vec3 tWorldPos[];
in float tHeight[];
flat in vec3 tWorldRoot[];
in vec2 tUV[];
flat in float tAtlasPage[];
in mat3 tTBN[];
in float tRoughness[];
in float tDistance[];

out vec3 fPosition;
out vec2 fUV;
flat out float fAtlasPage;
out mat3 fTBN;
out float fRoughness;
out float fDistance;

float interpolate1D(float v0, float v1, float v2)
{
    return gl_TessCoord.x * v0 + gl_TessCoord.y * v1 + gl_TessCoord.z * v2;
}

vec2 interpolate2D(vec2 v0, vec2 v1, vec2 v2)
{
    return vec2(gl_TessCoord.x) * v0 + vec2(gl_TessCoord.y) * v1 + vec2(gl_TessCoord.z) * v2;
}

vec3 interpolate3D(vec3 v0, vec3 v1, vec3 v2)
{
    return vec3(gl_TessCoord.x) * v0 + vec3(gl_TessCoord.y) * v1 + vec3(gl_TessCoord.z) * v2;
}

void main()
{
    // Interpolate the attributes of the output vertex using the barycentric coordinates
    vec3 worldPos = interpolate3D(tWorldPos[0], tWorldPos[1], tWorldPos[2]);
    float height = interpolate1D(tHeight[0], tHeight[1], tHeight[2]);
    fUV = interpolate2D(tUV[0], tUV[1], tUV[2]);
    fAtlasPage = tAtlasPage[0];
    fTBN = tTBN[0];
    fRoughness = tRoughness[0];
    fDistance = tDistance[0];
    
       // Displace the vertex along the normal
    //float Displacement = texture(gDisplacementMap, TexCoord_FS_in.xy).x;
    //worldPos += Normal_FS_in * Displacement * gDispFactor;
    worldPos.xyz += CameraRight * getWindAtPosition(-Time + height, vec4(tWorldRoot[0], 0.0)) * height * WIND_INTENSITY;
    fPosition = worldPos;
    gl_Position = VP * vec4(worldPos, 1.0);
}