rig: human
states:
  - name: idle
    asset_name: swrd_shld_idle
    state_type: AnimSequence
    transitions:
      - condition:
          type: is_moving
        to_state: move
  - name: move
    asset_name: move
    state_type: Blendspace1D
    transitions:
      - condition:
          type: is_not_moving
        to_state: idle
        dur: 0.3
