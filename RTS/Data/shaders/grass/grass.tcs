
// define the number of CPs in the output patch
layout (vertices = 3) out;

#include "../GlobalUbo.glsl"

// attributes of the input CPs
in vec3 fWorldPos[];
in float fHeight[];
flat in vec3 fWorldRoot[];
flat in vec2 fRelXY[];
in vec2 fUV[];
flat in int fGrassMaterial[];
in float fDistance[];
in vec2 fLean[];

// attributes of the output CPs
out vec3 tWorldPos[];
out vec2 tRelXY[];
out float tHeight[];
flat out vec3 tWorldRoot[];
out vec2 tUV[];
flat out int tGrassMaterial[];
flat out float tAtlasPage[];
out float tDistance[];
out vec2 tLean[];

float GetTessLevel(float Distance0, float Distance1) {
    float AvgDistance = (Distance0 + Distance1) / 2.0;

    if (AvgDistance <= 3.0) {
        return 4.0;
    }
    else if (AvgDistance <= 6.0) {
        return 3.0;
    }
    else if (AvgDistance <= 12.0) {
        return 2.0;
    }
    else {
        return 1.0;
    }
}

void main()
{
    // Set the control points of the output patch
    tWorldPos[gl_InvocationID] = fWorldPos[gl_InvocationID];
    tHeight[gl_InvocationID] = fHeight[gl_InvocationID];
    tWorldRoot[gl_InvocationID] = fWorldRoot[gl_InvocationID];
    tRelXY[gl_InvocationID] = fRelXY[gl_InvocationID];
    tUV[gl_InvocationID] = fUV[gl_InvocationID];
    tGrassMaterial[gl_InvocationID] = fGrassMaterial[gl_InvocationID];
    tDistance[gl_InvocationID] = fDistance[gl_InvocationID];
    tLean[gl_InvocationID] = fLean[gl_InvocationID];
    
    // Calculate the distance from the camera to the three control points
    float EyeToVertexDistance0 = distance(vec3(0.0), fWorldPos[0]);
    float EyeToVertexDistance1 = distance(vec3(0.0), fWorldPos[1]);
    float EyeToVertexDistance2 = distance(vec3(0.0), fWorldPos[2]);

    // Calculate the tessellation levels
    gl_TessLevelOuter[0] = GetTessLevel(EyeToVertexDistance1, EyeToVertexDistance2);
    gl_TessLevelOuter[1] = GetTessLevel(EyeToVertexDistance2, EyeToVertexDistance0);
    gl_TessLevelOuter[2] = GetTessLevel(EyeToVertexDistance0, EyeToVertexDistance1);
    gl_TessLevelInner[0] = gl_TessLevelOuter[2];
}