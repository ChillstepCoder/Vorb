<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  xmlns:local="clr-namespace:AM"
  x:Class="AM.Inventory"
  d:DesignWidth="1280" d:DesignHeight="720"
  Background="#FF242C32"
  FontFamily="titilium_bold"
  FontSize="15">
    <UserControl.Resources>
        <ImageSource x:Key="BackgroundImageSource">ui_sack_background.png</ImageSource>
        <ImageSource x:Key="ButtonBackgroundImage">inventory_tile.png</ImageSource>
        <ImageSource x:Key="PopupBackgroundImage">sack_popup_bar.png</ImageSource>
        <Style x:Key="InventoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="1,1"/>
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="112"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="6,8,0,26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5">
                            <Border.Background>
                                <ImageBrush ImageSource="{StaticResource ButtonBackgroundImage}" Stretch="Fill"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Border Width="1280" Height="720" Padding="400,0,360,0">
            <Border.Background>
                <ImageBrush ImageSource="{StaticResource BackgroundImageSource}" Stretch="Uniform"/>
            </Border.Background>
            <Border ClipToBounds="True">
                <ScrollViewer x:Name="ScrollViewer" VerticalScrollBarVisibility="Hidden" 
                              PreviewMouseWheel="OnScrollViewerPreviewMouseWheel"
                              Focusable="True"
                              PanningMode="VerticalOnly"
                              CanContentScroll="False"
                              Padding="0,43.5,0,46"
                              ScrollChanged="OnScrollViewerScrollChanged">
                    <ItemsControl x:Name="InventoryItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button x:Name="InventoryButton" Style="{StaticResource InventoryButtonStyle}"
                                            MouseEnter="OnInventoryButtonMouseEnter"
                                            MouseLeave="OnInventoryButtonMouseLeave"/>
                                    <local:CustomPopup x:Name="ItemPopup"
                                                       PlacementTarget="{Binding ElementName=InventoryButton}">
                                        <Border Width="462" Height="40">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{StaticResource PopupBackgroundImage}" Stretch="Uniform"/>
                                            </Border.Background>
                                            <TextBlock Text="Item Description" Foreground="White"/>
                                        </Border>
                                    </local:CustomPopup>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Border>
    </Viewbox>
</UserControl>
