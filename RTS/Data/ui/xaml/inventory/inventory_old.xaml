<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
  x:Class="AM.Inventory"
  d:DesignWidth="1280" d:DesignHeight="720"
  Background="#FF242C32"
  FontFamily="titilium_bold"
  FontSize="15">
    <UserControl.Resources>
        <ImageSource x:Key="BackgroundImageSource">ui_sack_background.png</ImageSource>
        <ImageSource x:Key="ButtonBackgroundImage">inventory_tile.png</ImageSource>
        <Style x:Key="InventoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="1,1"/>
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="112"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5">
                            <Border.Background>
                                <ImageBrush ImageSource="{StaticResource ButtonBackgroundImage}" Stretch="Fill"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Border Width="1280" Height="720" Padding="400,64">
            <Border.Background >
                <ImageBrush ImageSource="{StaticResource BackgroundImageSource}" Stretch="Uniform"/>
            </Border.Background>
            <Border ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource InventoryButtonStyle}"/>
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource InventoryButtonStyle}"/>
                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource InventoryButtonStyle}"/>
                    <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource InventoryButtonStyle}"/>
                    
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource InventoryButtonStyle}"/>
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource InventoryButtonStyle}"/>
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource InventoryButtonStyle}"/>
                    <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource InventoryButtonStyle}"/>
                    
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource InventoryButtonStyle}"/>
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource InventoryButtonStyle}"/>
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource InventoryButtonStyle}"/>
                    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource InventoryButtonStyle}"/>
                    
                    <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource InventoryButtonStyle}"/>
                    <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource InventoryButtonStyle}"/>
                    <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource InventoryButtonStyle}"/>
                    <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource InventoryButtonStyle}"/>
                </Grid>
            </Border>
        </Border>
    </Viewbox>
</UserControl>
